// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// PUBLISHER MODULE + STRUCTURED "NEW" DATASET  (Phase 3 — additive)
// ---------------------------------------------------------------------
// These models are the brand-new, structured dataset for the publisher
// tie-up program. They are completely separate from the legacy flat
// `Content` model (which stays untouched as the "Archived" dataset).
// Nothing here touches existing tables → zero risk to current data/users.
// Publisher login reuses the User model with role = "Publisher".
// =====================================================================

model Publisher {
  id            String   @id @default(uuid())
  name          String
  legalName     String?                       // registered legal entity name
  slug          String?  @unique
  email         String?
  contactNumber String?
  website       String?
  country       String?
  address       String?
  logoUrl       String?
  verified      Boolean  @default(false)      // "verified partner" badge

  // Organisation hierarchy — a self-referencing tree of arbitrary depth.
  // orgType: Group (parent/consortium) | Publisher | Imprint
  // e.g. "Consortium e-Learning Network" (Group) -> "JournalsPub" (Imprint) -> journals
  orgType       String   @default("Publisher")
  parentId      String?
  parent        Publisher?  @relation("PublisherTree", fields: [parentId], references: [id])
  children      Publisher[] @relation("PublisherTree")

  // Discovered = auto-found from ingestion, not yet contacted
  // Invited     = tie-up invitation + credentials sent
  // Active      = tie-up live (publisher can log in)
  // Inactive    = disabled
  tieUpStatus   String   @default("Discovered")
  agreementNote String?  @db.Text            // partnership summary (no revenue terms)
  allowedContentTypes Json? @default("[\"Journals\",\"Books\"]")

  source        String?                       // where first discovered (DOAJ/DOAB/OpenAlex/Manual)
  userId        String?  @unique              // linked Publisher-role User login (scalar, set on tie-up)

  discoveredAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  journals      Journal[]
  articles      Article[]
  books         Book[]
  locations     PublisherLocation[]
  contacts      PublisherContact[]
  agreements    PublisherAgreement[]
  uploads       PublisherUpload[]
  messages      PublisherMessage[]

  @@index([name])
  @@index([tieUpStatus])
  @@index([parentId])
  @@index([orgType])
}

// A publisher's physical presence — supports multi-country / multi-office giants.
model PublisherLocation {
  id          String   @id @default(uuid())
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  publisherId String
  label       String?                          // e.g. "Global HQ", "APAC Office"
  type        String   @default("Office")      // HQ | Regional | Editorial | Office
  country     String?
  city        String?
  address     String?  @db.Text
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([publisherId])
}

// People at a publisher. Each contact can optionally be a login seat (multi-seat teams).
model PublisherContact {
  id          String   @id @default(uuid())
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  publisherId String
  name        String
  email       String?
  title       String?                          // job title / role
  phone       String?
  isPrimary   Boolean  @default(false)
  userId      String?                          // linked User login if this contact is a seat
  scopeNodeId String?                          // publisher node this seat may see (default: own subtree)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publisherId])
  @@index([userId])
}

// A partnership agreement + its in-app e-signature record and audit trail.
model PublisherAgreement {
  id            String   @id @default(uuid())
  publisher     Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  publisherId   String
  title         String
  documentUrl   String?                        // uploaded contract PDF (S3)
  version       String?  @default("1.0")
  body          String?  @db.Text              // optional inline terms (if no PDF)
  note          String?  @db.Text
  // Draft | Sent | Viewed | Accepted | Declined
  status        String   @default("Draft")
  sentAt        DateTime?
  viewedAt      DateTime?
  decidedAt     DateTime?
  acceptedByName  String?
  acceptedByEmail String?
  signatureType String?                         // typed | drawn
  signatureData String?  @db.Text               // typed name or drawn-signature data URL
  declineReason String?  @db.Text
  ipAddress     String?
  userAgent     String?
  auditTrail    Json?    @default("[]")          // [{event, at, by, ip}]
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([publisherId])
  @@index([status])
}

// Reusable agreement templates the admin can start a new agreement from.
model AgreementTemplate {
  id        String   @id @default(uuid())
  title     String
  version   String?  @default("1.0")
  body      String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())
}

// Two-way message thread between the STM team and a publisher (with read receipts).
model PublisherMessage {
  id            String   @id @default(uuid())
  publisher     Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  publisherId   String
  sender        String                             // 'admin' | 'publisher'
  senderName    String?
  body          String   @db.Text
  attachmentUrl String?
  readAt        DateTime?                           // when the other party read it (receipt)
  createdAt     DateTime @default(now())

  @@index([publisherId])
}

// One row per read of a new-dataset item — powers the reads time-series.
model ReadEvent {
  id          String   @id @default(uuid())
  itemType    String                               // 'article' | 'book'
  itemId      String
  publisherId String?
  userId      String?
  at          DateTime @default(now())

  @@index([publisherId, at])
  @@index([at])
}

// Tracks each bulk data-sharing batch a publisher (or admin) submits.
model PublisherUpload {
  id          String   @id @default(uuid())
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  publisherId String
  kind        String   @default("article")     // article | book
  fileName    String?
  fileUrl     String?                            // stored CSV / manifest (S3)
  rows        Int      @default(0)
  accepted    Int      @default(0)
  rejected    Int      @default(0)
  status      String   @default("Pending")       // Pending | Processed | Failed
  note        String?  @db.Text
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([publisherId])
}

model Journal {
  id            String   @id @default(uuid())
  issn          String?  @unique             // canonical key — groups articles reliably
  eissn         String?
  title         String

  publisher     Publisher? @relation(fields: [publisherId], references: [id])
  publisherId   String?
  publisherName String?                       // denormalized for display

  subject       String?
  domain        String?                       // department (from DOMAINS)
  language      String?
  country       String?
  startYear     Int?                          // founding year — powers "new journals in last N years"
  openAccess    Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  articles      Article[]

  @@index([publisherId])
  @@index([domain])
  @@index([startYear])
}

model Article {
  id            String   @id @default(uuid())
  contentType   String?  @default("Periodicals") // Periodicals | Magazines | Case Reports | Theses | Conference Proceedings | Newsletters | Educational Videos
  metadata      Json?    @default("{}")           // type-specific extras (hospital, specialty, university, degree, supervisor, location, sponsor, issueDate, releaseDate, speaker, duration, tags, thumbnailUrl...)
  title         String
  authors       String?
  abstract      String?  @db.Text
  doi           String?
  pdfUrl        String?

  journal       Journal? @relation(fields: [journalId], references: [id])
  journalId     String?
  journalName   String?                       // denormalized
  journalIssn   String?                       // denormalized

  publisher     Publisher? @relation(fields: [publisherId], references: [id])
  publisherId   String?
  publisherName String?

  volume        String?
  issue         String?
  year          Int?                          // publication year of this article/volume
  pages         String?

  domain        String?                       // department (denormalized for filtering)
  subject       String?
  language      String?
  country       String?

  accessType    String   @default("OpenAccess")   // OpenAccess | Subscription
  status        String   @default("Draft")         // Draft | Published | Rejected
  rejectionNote String?                            // shown to publisher when rejected
  source        String?                            // DOAJ | OpenAlex | Manual | ...
  fingerprint   String?  @unique                    // dedup (doi or issn+title+vol+issue)

  // Who this content originated from. CRITICAL for stealth: publisher-facing
  // queries only ever return PublisherSubmitted — pre-scraped Ingested rows
  // are never visible to a tied-up publisher.
  ownershipSource String @default("Ingested")       // Ingested | PublisherSubmitted | AdminEntered
  uploadId      String?                            // PublisherUpload batch, if bulk-submitted
  views         Int      @default(0)               // read count (impact analytics)

  createdBy     String?                            // publisher id/email or admin
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([journalId])
  @@index([publisherId])
  @@index([domain])
  @@index([year])
  @@index([status])
  @@index([contentType])
  @@index([ownershipSource])
}

model Book {
  id            String   @id @default(uuid())
  title         String
  authors       String?

  publisher     Publisher? @relation(fields: [publisherId], references: [id])
  publisherId   String?
  publisherName String?

  isbn          String?
  doi           String?
  year          Int?                          // publication / starting year
  edition       String?
  pages         String?
  metadata      Json?    @default("{}")
  subject       String?
  domain        String?                       // department
  language      String?
  country       String?
  description   String?  @db.Text
  coverUrl      String?
  pdfUrl        String?                        // whole-book PDF (optional; chapters below)

  accessType    String   @default("OpenAccess")
  status        String   @default("Draft")         // Draft | Published | Rejected
  rejectionNote String?                            // shown to publisher when rejected
  source        String?
  fingerprint   String?  @unique

  ownershipSource String @default("Ingested")       // Ingested | PublisherSubmitted | AdminEntered
  uploadId      String?
  views         Int      @default(0)               // read count (impact analytics)

  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapters      Chapter[]

  @@index([publisherId])
  @@index([domain])
  @@index([status])
  @@index([ownershipSource])
}

model Chapter {
  id            String   @id @default(uuid())
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId        String
  bookTitle     String?                        // denormalized
  chapterNumber Int?
  title         String
  authors       String?
  pdfUrl        String?
  pages         String?
  status        String   @default("Draft")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([bookId])
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  password     String
  displayName  String?
  organization String?
  contact      String?
  designation  String?
  state        String?
  role         String         @default("Subscriber")
  status       String         @default("Active")
  isBlocked    Boolean        @default(false)
  isFirstLogin Boolean        @default(false)
  
  isDemoAccount Boolean       @default(false)
  demoExpiresAt DateTime?

  institution  Institution?   @relation(fields: [institutionId], references: [id])
  institutionId String?
  
  institutionProfile Json?    @default("{}")
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  payments              Payment[]
  subscriptions         Subscription[]
  quotations            Quotation[]
  submissions           Submission[]
  usageLogs             UsageLog[]
  subscriptionRequests  SubscriptionRequest[]
  activities            StudentActivity[]
  couponUsages          CouponUsage[]
  favorites             Favorite[]
  feedbacks             Feedback[]
  
  assignedLeads         Lead[]            @relation("AssignedLeads")
  leadInteractions      LeadInteraction[] @relation("UserInteractions")
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String?  @unique
  paymentId String?  @unique
  amount    Float
  status    String   @default("Pending")
  method    String?  @default("Razorpay")
  
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  
  items     Json
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?  @db.Text
  type      String   @default("General")
  
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  
  createdAt DateTime @default(now())
}

model Subscription {
  id             String   @id @default(uuid())
  domainId       String?
  domainName     String?
  planName       String
  planType       String   @default("Monthly")   // Monthly | Yearly | Custom
  durationMonths Int      @default(1)
  duration       String?  // deprecated label field (kept for compat)
  status         String   @default("Active")   // Active | Expired | Cancelled
  
  domains        Json?    @default("[]")
  contentTypes   Json?    @default("[]")
  allowedContentTypes Json? @default("[]") // Adding for legacy compatibility
  
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?
  
  institution    Institution? @relation(fields: [institutionId], references: [id])
  institutionId  String?
  
  request        SubscriptionRequest? @relation(fields: [requestId], references: [id])
  requestId      String?  @unique
  
  startDate      DateTime @default(now())
  endDate        DateTime
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
}

model SubscriptionRequest {
  id             String   @id @default(uuid())
  userName       String
  email          String
  planType       String   @default("Monthly")   // Monthly | Yearly | Custom
  durationMonths Int      @default(1)
  planDescription String? // e.g. "All Domains Package"
  paymentRef     String?  // screenshot URL or payment reference
  notes          String?
  status         String   @default("Pending")   // Pending | Approved | Rejected
  rejectionNote  String?
  
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?
  
  subscription   Subscription?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Quotation {
  id                String   @id @default(uuid())
  userEmail         String
  userName          String
  organization      String?
  state             String?
  items             Json
  subtotal          Float
  gstAmount         Float
  total             Float
  status            String   @default("Pending")  // Pending | Approved | Paid | Cancelled

  // Dynamic pricing fields
  selectedModules   Json?    @default("[]")       // Array of ContentModule IDs selected
  pricingBreakdown  Json?    @default("{}")        // { modules: [{id, domain, contentType, price}], planType, subtotal, gst, total }
  planType          String?  @default("Monthly")   // Monthly | Quarterly | Yearly
  allowedDomain     String?  // null means all domains
  notes             String?

  user              User?    @relation(fields: [userId], references: [id])
  userId            String?
  
  createdBy         String?  // The user ID or email of the person who generated the quotation (Admin or Self)
  sentEmailHtml     String?  // The exact HTML template that was emailed to the user

  createdAt         DateTime @default(now())
  expiresAt         DateTime
  
  discountAmount    Float?   @default(0.0)
  couponCode        String?

  mobile            String?
  designation       String?
  address           String?
  pincode           String?
  city              String?
  country           String?
  gstNumber         String?
  userCategory      String?
  deliveryMethod    String?  @default("Email") // Email | Download
}

model Receipt {
  id             String    @id @default(uuid())
  receiptNumber  String    @unique                 // RCP-YYYY-MM-NN

  // Soft links (scalar, no FK constraints) — a receipt is an immutable snapshot
  quotationId    String?
  userId         String?

  // Bill-to snapshot (copied from the quotation at payment time)
  userEmail      String
  userName       String
  organization   String?
  state          String?
  address        String?
  pincode        String?
  gstNumber      String?
  mobile         String?
  userCategory   String?

  // Amount snapshot
  items          Json
  subtotal       Float
  gstAmount      Float
  total          Float
  discountAmount Float?    @default(0.0)
  couponCode     String?
  planType       String?
  allowedDomain  String?

  // Payment details
  paymentMethod  String    @default("Bank Transfer") // Bank Transfer | UPI | Razorpay | Cheque | Cash
  paymentRef     String?                              // transaction / reference number
  paymentDate    DateTime  @default(now())

  createdBy      String?
  emailSentAt    DateTime?
  createdAt      DateTime  @default(now())
}

model ContentModule {
  id                String   @id @default(uuid())
  domain            String
  contentType       String
  userType          String   @default("General")   // General | Student Scholar | College Excellence | University Global | Corporate Innovator
  totalCount        Int      @default(0)
  monthlyPrice      Float    @default(0)
  quarterlyPrice    Float    @default(0)
  halfYearlyPrice   Float    @default(0)
  yearlyPrice       Float    @default(0)
  yearlyDiscountPct Float    @default(0)   // e.g. 20 means 20% off yearly
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())

  @@unique([domain, contentType, userType])
}

model Submission {

  id              String   @id @default(uuid())
  title           String
  authors         String
  contentType     String
  subjectArea     String?  @default("General")
  fileUrl         String?
  publishingMode  String
  status          String   @default("Pending")
  
  user            User?    @relation(fields: [userId], references: [id])
  userId          String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  content         Content?
}

model Content {
  id              String   @id @default(uuid())
  title           String
  description     String?
  authors         String
  domain          String?
  contentType     String
  subjectArea     String?  @default("General")
  fileUrl         String?
  thumbnailUrl    String?
  tags            Json?    @default("[]")
  price           Float?   @default(0.0)
  accessType      String   @default("Subscription")
  status          String   @default("Published")
  publishingMode  String   @default("Direct")
  views           Int      @default(0)

  // ── Viewer-Based Validation ─────────────────────────────
  validationStatus  String?   @default("Not Validated") // "Not Validated" | "VALID_VIEWABLE" | "FLAGGED_CONTENT"
  viewerStatus      String?                              // "Rendered OK" | "Load Failed" | "Timeout" | "No File" | "Not PDF/Video"
  isViewable        Boolean?  @default(false)
  flaggedReason     String?
  lastValidatedAt   DateTime?

  fingerprint     String?   @unique  // SHA-256 of normalized title+authors

  submission      Submission? @relation(fields: [submissionId], references: [id])
  submissionId    String?     @unique
  
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())
  
  studentActivities StudentActivity[]
  favorites         Favorite[]
}

model AccessRequest {
  id            String   @id @default(uuid())
  institution   String
  contactPerson String
  email         String
  phone         String
  requestType   String   @default("Trial")
  status        String   @default("Pending")
  
  createdAt     DateTime @default(now())
}

model UsageLog {
  id            String   @id @default(uuid())
  action        String
  details       String?
  points        Int?     @default(0)
  
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?
  
  createdAt     DateTime @default(now())
}

model Institution {
  id              String   @id @default(uuid())
  name            String
  subscriptionId  String?  @unique
  status          String   @default("Active")
  
  users           User[]
  subscriptions   Subscription[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StudentActivity {
  id          String   @id @default(uuid())
  
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  
  content     Content? @relation(fields: [contentId], references: [id])
  contentId   String?
  
  timeSpent   Int      @default(0)
  lastPage    Int      @default(1)
  accessedAt  DateTime @default(now()) @updatedAt

  @@index([userId, contentId])
}

model Bundle {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  domains         Json     @default("[]")
  contentTypes    Json     @default("[]")
  price           Float    @default(0.0)
  durationMonths  Int      @default(1)
  status          String   @default("Active")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ValidationReport {
  id                 String   @id @default(uuid())
  type               String   // "Manual" | "Automatic"
  validationType     String   @default("Metadata")  // "Metadata" | "ViewerBased" | "Full"
  status             String   @default("Draft") // "Draft" | "Reviewing" | "Resolved"
  totalItemsScanned  Int      @default(0)
  issuesFound        Int      @default(0)
  validCount         Int      @default(0)   // Items confirmed VALID_VIEWABLE
  flaggedCount       Int      @default(0)   // Items confirmed FLAGGED_CONTENT
  issues             Json     // Array of issue details { contentId, title, issueType, description }
  draftedContentIds  Json     @default("[]") // Persisted list of content IDs moved to Draft
  timeline           Json     @default("[]") // Audit trail: [{ action, by, at, count, note }]

  startedAt          DateTime @default(now())
  completedAt        DateTime?
}

model AgencyInquiry {
  id             String   @id @default(uuid())
  agencyName     String
  contactPerson  String
  email          String
  phone          String
  region         String
  experience     String
  message        String?
  status         String   @default("Pending") // Pending | Accepted | Rejected
  discount       Int?     // 30 or 40
  validUntil     DateTime? // Expiration date for the partnership
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactInquiry {
  id           String   @id @default(uuid())
  fullName     String
  email        String
  mobile       String?
  whatsapp     String?
  designation  String?
  departments  Json?    @default("[]")   // Array of department strings
  state        String?
  organization String?
  message      String
  status       String   @default("New")  // New | Read | Replied | Resolved | Archived
  adminNotes   String?
  replyText    String?
  repliedAt    DateTime?

  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lead {
  id           String   @id @default(uuid())
  name         String
  email        String
  phone        String?
  organization String?
  state        String?
  source       String   @default("Manual") // Demo Request, Contact Inquiry, Manual
  status       String   @default("All")    // All, Positive, No Response, Subscriber, In Progress, Negative, Repeated
  notes        String?  @db.Text
  
  assignedToId String?
  assignedTo   User?    @relation("AssignedLeads", fields: [assignedToId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interactions LeadInteraction[]
}

model LeadInteraction {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  
  userId    String
  user      User     @relation("UserInteractions", fields: [userId], references: [id])
  
  type      String   @default("Note") // Call, Email, Meeting, Note, StatusChange
  notes     String   @db.Text
  
  createdAt DateTime @default(now())
}

model Coupon {
  id                 String        @id @default(uuid())
  code               String        @unique
  discountType       String        @default("percentage") // "percentage" | "fixed"
  discountValue      Float
  maxUses            Int?          // null means unlimited
  usedCount          Int           @default(0)
  validFrom          DateTime?
  validUntil         DateTime?
  isActive           Boolean       @default(true)
  minimumOrderAmount Float?

  usages             CouponUsage[]
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model CouponUsage {
  id         String   @id @default(uuid())
  
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  couponId   String
  
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  
  orderId    String?  // Reference to Quotation ID or Payment ID
  discount   Float    // The actual discount amount applied
  
  usedAt     DateTime @default(now())
}

model DemoRequest {
  id                 String   @id @default(uuid())
  fullName           String
  institutionalEmail String
  institutionName    String
  designation        String?
  whatsappNumber     String?
  city               String?
  state              String?
  department         String
  requestType        String?  @default("Institution") // Institution | Student | Corporate
  status             String   @default("Pending") // Pending | Contacted | Completed
  adminNotes         String?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ExtractionJob {
  id              String   @id @default(uuid())
  name            String                        // "Medical Sciences OJS Import"
  sourceType      String                        // "OJS" | "URL" | "CSV" | "Manual"
  sourceConfig    Json                          // { baseUrl, domain hints, etc. }
  targetDomain    String?                       // Pre-filter domain, or null for auto-classify
  targetContentType String?                     // Pre-filter type, or null for auto-classify
  
  status          String   @default("Pending")  // Pending | Running | Completed | Failed
  
  totalDiscovered Int      @default(0)
  totalProcessed  Int      @default(0)
  totalInserted   Int      @default(0)
  totalDuplicates Int      @default(0)
  totalFailed     Int      @default(0)
  totalFlagged    Int      @default(0)          // Low-confidence items for review
  
  errorLog        Json     @default("[]")       // Array of error details
  
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  items           ExtractionItem[]
}

model ExtractionItem {
  id              String   @id @default(uuid())
  
  job             ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId           String
  
  rawData         Json                          // Original scraped data
  aiResult        Json?                         // AI classification output
  fingerprint     String?                       // Dedup fingerprint
  
  status          String   @default("Pending")  // Pending | Classified | Validated | Inserted | Duplicate | Failed | Flagged
  
  // Final mapped fields (after AI processing)
  title           String?
  authors         String?
  description     String?
  domain          String?
  contentType     String?
  subjectArea     String?
  fileUrl         String?
  tags            Json?    @default("[]")
  
  confidence      Float?   @default(0)          // AI confidence score
  validationResult Json?                        // PDF validation details
  errorMessage    String?
  
  contentId       String?                       // ID of inserted Content record (if successful)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([jobId, status])
  @@index([fingerprint])
}

model Favorite {
  id        String   @id @default(uuid())
  
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  
  content   Content  @relation(fields: [contentId], references: [id])
  contentId String

  createdAt DateTime @default(now())

  @@unique([userId, contentId])
}

model EmailVerification {
  id          String   @id @default(uuid())
  email       String   @unique
  isVerified  Boolean  @default(false)
  otp         String?
  otpExpiry   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PageVisit {
  id        String   @id @default(uuid())
  path      String   
  userId    String?  
  userRole  String?  
  ipAddress String?  
  userAgent String?  
  sessionId String?
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  status    String   // "Sent" | "Failed"
  error     String?  @db.Text
  htmlContent String? @db.Text
  createdAt DateTime @default(now())
}
