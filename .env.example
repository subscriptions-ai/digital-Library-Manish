# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Configuration (Nodemailer - Amazon SES)
EMAIL_FROM=info@celnet.in
ADMIN_EMAIL=info@celnet.in
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Media Storage — blog covers and runtime media go here so they survive container replacement.
# AWS_S3_BUCKET is required in production; without it uploads are rejected (no silent local fallback).
AWS_S3_BUCKET=
# Optional: CDN base URL. When set, public media URLs use this instead of direct S3.
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional: object key prefix (default: "blog").
# AWS_S3_BLOG_PREFIX=blog

# Legacy Email Configuration (Gmail/SMTP)
# EMAIL_USER=
# EMAIL_PASS=
# SMTP_HOST=
# SMTP_PORT=

# Public AI assistant (all optional; the values shown are the defaults)
# Model used by the public assistant. Must support function calling. A model that "thinks" by default spends the
# output cap on thinking: also set AI_ASSISTANT_THINKING_BUDGET=0 for it where the model allows.
# AI_ASSISTANT_MODEL=gemini-3.5-flash-lite
# AI_ASSISTANT_THINKING_BUDGET=
# Questions an anonymous visitor may ask per window (the window rolls), and the window length.
# AI_ANONYMOUS_QUESTIONS_PER_HOUR=4
# AI_ANONYMOUS_WINDOW_MINUTES=60
# Questions allowed per window once the visitor has shared their details.
# AI_LEAD_QUESTIONS_PER_HOUR=12
# Abuse ceiling on model calls per IP address per window (an institution shares one address, so keep it generous).
# AI_IP_QUESTIONS_PER_HOUR=60
# Deadline for one answer, in milliseconds, tool lookups included.
# AI_ASSISTANT_TIMEOUT_MS=8000
# Output cap per answer, earlier messages sent with a question, and tool rounds per question (0-2).
# AI_ASSISTANT_MAX_OUTPUT_TOKENS=320
# AI_ASSISTANT_HISTORY_MESSAGES=2
# AI_ASSISTANT_MAX_TOOL_ROUNDS=1

# Ingestion: the fair rotation (all optional; the values shown are the defaults). Server-side only — never sent to the browser.
# Candidates CHECKED per provider turn. A budget on what is looked at, not a quota of what must be inserted.
# INGESTION_BATCH_SIZE=100
# Consecutive failed requests before a source rests and the next one takes over the same turn. (HTTP 429 sets a source aside at once.)
# INGESTION_FAILURES_BEFORE_FALLBACK=3
# Consecutive batches with nothing useful before a healthy source is set aside for a while (not called failed).
# INGESTION_ZERO_YIELD_BATCHES_BEFORE_ROTATION=3
# How long such a source is left out of the rotation, in hours.
# INGESTION_EXHAUSTED_HOURS=6
# Seconds before the same source is asked again after failure 1 and failure 2, comma separated.
# INGESTION_SOFT_BACKOFF_SECONDS=30,90
# Milliseconds to pause between journal visits for an article source (default 250 OpenAlex, 150 Crossref).
# INGESTION_ARTICLE_PAUSE_MS=
# INGESTION_ROTATION=0 puts the engine back on the previous scheduler (OpenAlex-only articles). No data is touched either way.
# Crossref's polite pool asks for a way to reach you. Used for Crossref requests only.
# CROSSREF_MAILTO=
# CROSSREF_USER_AGENT=
# NCBI's own limits are unchanged and always win over the batch size:
# NCBI_BOOKS_MAX_ARCHIVES_PER_DAY=50
# NCBI_BOOKS_MAX_BYTES_PER_DAY=524288000
# NCBI_BOOKS_MAX_ARCHIVE_BYTES=52428800
# NCBI_BOOKS_DOWNLOAD_CONCURRENCY=1

# AI_SECRET_ENCRYPTION_KEY: master secret that encrypts credentials stored from Admin > AI Assistant (AES-256-GCM).
# 32 random bytes, base64 or 64 hex characters. Generate with: openssl rand -base64 32
# Set it in the server environment (Coolify) only. Never commit it, never store it in the database. If it is lost or changed,
# an Admin-stored key can no longer be opened (the server falls back to GEMINI_API_KEY) and must be entered again.
# AI_SECRET_ENCRYPTION_KEY=

# Sign in with Google (web OAuth client; no client secret is used). ONE variable, read by the server at runtime: it verifies credentials
# against it AND hands it to the page (GET /api/public/google-config), so the two can never differ and changing it needs a restart, not a
# rebuild. VITE_GOOGLE_CLIENT_ID is no longer read and can be deleted. A real ID is <project number>-<lower-case letters and digits>.apps.googleusercontent.com
# (a capital O in place of a zero names no client at Google; the server refuses such a value and says so in its start-up log).
# Authorized JavaScript origins in Google Cloud: the exact origins, no path: https://journalslibrary.com, https://www.journalslibrary.com, http://localhost:3000
GOOGLE_CLIENT_ID=

# Review Automation — department assignment for the "Needs a department" Books (it never publishes a book).
# Every assignment action (Batch Review, Auto-assign High Confidence) is OFF unless this is exactly "true".
# Analysis, the v1/v2 comparison, previews and Review History work without it.
# REVIEW_AUTO_ASSIGN_ENABLED=false
# The approved "High confidence" rule, written down. Auto-assign High Confidence refuses to start without all three keys.
# REVIEW_AUTO_ASSIGN_THRESHOLDS={"highMinScore":6,"highMinMargin":3,"highRequiresCode":true}

# Review Automation — PUBLISHING eligible Books to the public catalogue (Publish Eligible High / Medium / Selected).
# A gate of its own: department assignment being enabled does not enable publication. Publication also needs REVIEW_AUTO_ASSIGN_ENABLED=true
# (it can assign a missing department) and, for the bulk jobs, REVIEW_AUTO_ASSIGN_THRESHOLDS. Off unless exactly "true".
# Every book must still pass the application's own publication rules (year, licence, rights, access, scope, duplicates); confidence only chooses the department.
# REVIEW_AUTO_PUBLISH_ENABLED=false

# Review Automation R3A — FUTURE-INGESTION routing. A Book the harvest has just written as a Draft is classified once; if it is High confidence under the approved rule
# its suggested department is assigned and it STAYS A DRAFT (nothing is published, no licence/access/rights/file/source change). Medium, Low and Unclassifiable go to the review queue.
# A gate of its own: enabling historical assignment (REVIEW_AUTO_ASSIGN_ENABLED) does not enable this, and this does not enable that. Off unless exactly "true".
# It also needs the approved rule (REVIEW_AUTO_ASSIGN_THRESHOLDS above) and an explicit classifier (v1 or v2); without either it does nothing.
# REVIEW_INGEST_ROUTING_ENABLED=false
# REVIEW_INGEST_ROUTING_CLASSIFIER=v1

# Review Automation R3B — JOURNALS. Assign Department, Stay Current Status: a journal with no department is given one by an administrator in Batch Review (Journals).
# Writes the department ONLY: status, licence, rights, ISSN/eISSN, publisher and every other field are untouched; nothing is published, approved or rejected; a department,
# a Rejected journal, a partner publisher's journal and a hand-verified one are never touched. A gate of its own, separate from the Book gates. Off unless exactly "true".
# The analysis, the list and the previews always work; only writing is gated.
# REVIEW_JOURNAL_ASSIGN_ENABLED=false
# The approved journal rule, written down (all three keys). Without it the provisional thresholds are used and the screen says so.
# REVIEW_JOURNAL_ASSIGN_THRESHOLDS={"highMinScore":8,"highMinMargin":4,"highRequiresBoth":true}
